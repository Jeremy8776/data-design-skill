{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-architecture-discovery/case.schema.json",
  "title": "Portable AI Architecture Discovery Case",
  "type": "object",
  "required": ["schemaVersion", "caseId", "caseName", "createdAt", "updatedAt", "sources", "records", "observations", "questions", "answers", "thesis", "coverage", "provenance"],
  "properties": {
    "schemaVersion": { "enum": ["0.2.0", "0.3.0", "0.4.0", "0.5.0"] },
    "caseId": { "type": "string", "minLength": 1 },
    "caseName": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "type": "object" } },
    "records": { "type": "array", "items": { "type": "object" } },
    "observations": { "type": "array", "items": { "type": "object" } },
    "questions": { "type": "array", "items": { "type": "object" } },
    "answers": { "type": "array", "items": { "type": "object" } },
    "conceptRounds": { "type": "array", "items": { "$ref": "concept-round.schema.json" } },
    "conceptDecision": { "type": ["object", "null"] },
    "structure": { "type": ["object", "null"] },
    "scanPolicy": { "type": ["object", "null"] },
    "indexes": { "type": "array", "items": { "type": "object" } },
    "workflow": {
      "type": "object",
      "required": ["version", "status", "currentStage", "updatedAt", "stages", "events"],
      "properties": {
        "version": { "type": "string" },
        "status": { "enum": ["active", "complete"] },
        "currentStage": { "enum": ["ingest", "analyse", "clarify", "report"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "stages": { "type": "object" },
        "events": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "thesis": { "type": "object" },
    "coverage": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
